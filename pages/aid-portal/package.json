{
  "name": "aid-ds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/ensure-icon-dimensions.mjs && node scripts/build-guides.mjs && vite",
    "prebuild": "node scripts/ensure-icon-dimensions.mjs && node scripts/ensure-token-changelogs.mjs && node scripts/sync-token-changelogs.mjs && node scripts/build-guides.mjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.api.json",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test:browser": "vitest run --project browser",
    "test:browser:update": "vitest run --project browser --update",
    "build:yc-function": "node deploy/yc/build-function.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/roboto": "5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/browser-playwright": "5.0.1",
    "axe-core": "4.13.0",
    "esbuild": "0.25.12",
    "jsdom": "^30.1.0",
    "marked": "^18.0.13",
    "playwright": "1.63.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^5.0.1"
  }
}
