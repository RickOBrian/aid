# Cookie session auth for Presentbook (middleware.ts + api/login.ts).
# Copy to .env.local for local testing with `vercel dev` (not used by Vite `npm run dev`).

BASIC_AUTH_USER=your-username
BASIC_AUTH_PASSWORD=your-strong-password
AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32

# Figma plugin → POST /api/registry/propose-decision (server-side GitHub write flow)
PLUGIN_SHARED_SECRET=generate-with-openssl-rand-base64-32
GITHUB_TOKEN=github_pat_with_repo_contents_and_pull_requests_write
REGISTRY_OWNER=RickOBrian
REGISTRY_REPO=aid
REGISTRY_PATH=decisions-registry.json
REGISTRY_REVIEWER=RickOBrian
