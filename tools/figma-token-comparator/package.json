{
  "name": "figma-token-comparator",
  "version": "1.4.0",
  "private": true,
  "description": "Figma plugin: детерминированное сравнение цветов и типографики макета с эталонной библиотекой Figma. Без LLM/AI.",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:pack": "node scripts/release.mjs",
    "icons:report": "esbuild scripts/iconLibraryReport.ts --bundle --platform=node --outfile=dist/icon-library-report.cjs --log-level=warning && node dist/icon-library-report.cjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@figma/plugin-typings": "^1.137.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
